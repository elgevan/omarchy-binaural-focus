#!/usr/bin/bash

set -u

readonly player=/usr/bin/mpv
readonly setpriv=/usr/bin/setpriv
readonly setsid=/usr/bin/setsid
readonly sleep=/usr/bin/sleep

if [[ $# -ne 1 ]]; then
  echo "Usage: play-audio AUDIO_FILE" >&2
  exit 64
fi

for executable in "$player" "$setpriv" "$setsid" "$sleep"; do
  if [[ ! -x $executable ]]; then
    echo "Required executable not found: $executable" >&2
    exit 127
  fi
done

child_pid=""

cleanup_group() {
  local pid=$child_pid
  [[ -n $pid ]] || return

  if kill -0 -- "-$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    "$sleep" 0.2
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi

  wait "$pid" 2>/dev/null || true
  child_pid=""
}

stop() {
  trap - HUP INT TERM
  exit 143
}

trap cleanup_group EXIT
trap stop HUP INT TERM

"$setpriv" --pdeathsig KILL "$setsid" "$player" \
  --no-config \
  --no-video \
  --audio-display=no \
  --gapless-audio=yes \
  --loop-file=inf \
  --msg-level=all=error \
  --volume=50 \
  "$1" &
child_pid=$!

wait "$child_pid"
exit $?
